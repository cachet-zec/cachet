# Production secrets for the public read-only instance. Copy to .env.prod
# (gitignored) and fill in. ALL THREE are required: with any left blank the
# stack does NOT come up (Postgres refuses to initialize without a
# password, and the server exits if the snapshot key is not valid hex), so
# a misconfiguration fails loud rather than running insecure.
#
# All values are instance-local:
#
# - POSTGRES_PASSWORD: generate something long and random; it never leaves
#   the docker network. Use alphanumerics only — it is interpolated into a
#   postgres:// URL, so @ : / % would need escaping.
# - CACHET_SEED_PHRASE: a THROWAWAY seed for this read-only instance
#   (generate with `cachet-server --generate-seed`). Never put a real
#   issuer seed here: a public server must hold nothing worth stealing.
POSTGRES_PASSWORD=
CACHET_SEED_PHRASE=
# - CACHET_SNAPSHOT_KEY: Ed25519 seed for signed registry snapshots
#   (generate with `cachet-server --generate-snapshot-key`; publish the
#   printed public key out of band).
CACHET_SNAPSHOT_KEY=

# Optional. Blank disables each.
# - CACHET_ADMIN_TOKEN: enables the token-gated moderation API and the
#   console's /admin page. Generate with `openssl rand -hex 32`; shorter
#   than 32 characters is refused (the surface stays disabled), and
#   without it every admin route answers 404.
# - CACHET_DISCORD_WEBHOOK: a Discord webhook URL notified when a mint is
#   relayed through this instance (public facts only: asset ids + txid).
CACHET_ADMIN_TOKEN=
CACHET_DISCORD_WEBHOOK=

# Optional: asset ids the landing showcase leads with, comma-separated, in order.
# Public data; baked into the console at build time by deploy.sh.
CACHET_FEATURED_ASSETS=

# Optional, all baked into the console at build time by deploy.sh (it reads
# them here and passes them on as the console's NEXT_PUBLIC_CACHET_* build
# arguments). Blank disables each.
# - CACHET_REGISTRIES: other registries this console offers to read from,
#   comma-separated origins (https://api.example.org). Each operator listed
#   must allow this console's origin in its own CACHET_CORS_ORIGIN.
# - CACHET_EXPLORER_BLOCK_URL / CACHET_EXPLORER_TX_URL: block explorer URL
#   templates with a `{height}` / `{txid}` placeholder
#   (https://explorer.example/block/{height}); heights and transaction ids in
#   an asset's history link to them. Unset, they stay plain text.
CACHET_REGISTRIES=
CACHET_EXPLORER_BLOCK_URL=
CACHET_EXPLORER_TX_URL=

# Optional. Origins allowed to call this API from a browser, comma separated,
# your own console first (it is also the link origin in Discord notifications).
# Defaults to https://cachetzec.com: a self-hoster sets their own. Add another
# console's origin only if you want it to read this registry.
# CACHET_CORS_ORIGIN=https://example.org
