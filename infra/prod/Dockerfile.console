# Cachet console, production image. Build context = repository root:
#   docker build -f infra/prod/Dockerfile.console \
#     --build-arg NEXT_PUBLIC_CACHET_API_URL=https://api.cachetzec.com \
#     --build-arg NEXT_PUBLIC_CACHET_SITE_URL=https://cachetzec.com \
#     -t cachet-console:prod .
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so both origins are
# build arguments, not runtime variables. The site origin is what
# robots.txt, sitemap.xml and the social-card metadata advertise.
FROM node:22-bookworm-slim
RUN corepack enable
WORKDIR /app

# Workspace manifests first, for layer caching.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY console/package.json console/
COPY packages/api-client/package.json packages/api-client/
RUN pnpm install --frozen-lockfile

# Sources; the TS client is generated from the committed OpenAPI document.
COPY packages/api-client/ packages/api-client/
COPY console/ console/
RUN pnpm --filter @cachet/api-client generate

ARG NEXT_PUBLIC_CACHET_API_URL
ARG NEXT_PUBLIC_CACHET_SITE_URL
ENV NEXT_PUBLIC_CACHET_API_URL=$NEXT_PUBLIC_CACHET_API_URL \
    NEXT_PUBLIC_CACHET_SITE_URL=$NEXT_PUBLIC_CACHET_SITE_URL \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
RUN pnpm --filter @cachet/console build

# Drop root: hand the built app to the image's unprivileged `node` user
# and run as it (least privilege if the container is ever breached).
RUN chown -R node:node /app
USER node

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD node -e "fetch('http://localhost:3000').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm", "--filter", "@cachet/console", "start"]
