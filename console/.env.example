# Base URL of the Cachet server (cachet-server binary).
NEXT_PUBLIC_CACHET_API_URL=http://localhost:8080

# Other registries this console can read from, comma separated origins
# (mirrors, other instances). The visitor picks one in the footer; each
# must allow this console's origin in its CACHET_CORS_ORIGIN.
# NEXT_PUBLIC_CACHET_REGISTRIES=https://api.mirror.example

# Optional block explorer for the chain this console reads. URL templates:
# `{height}` and `{txid}` are replaced. Unset, heights and txids are plain text.
# NEXT_PUBLIC_CACHET_EXPLORER_BLOCK_URL=https://explorer.example/block/{height}
# NEXT_PUBLIC_CACHET_EXPLORER_TX_URL=https://explorer.example/tx/{txid}

# Privacy rule P1 (docs/PRIVACY.md): Next.js telemetry stays off.
NEXT_TELEMETRY_DISABLED=1
